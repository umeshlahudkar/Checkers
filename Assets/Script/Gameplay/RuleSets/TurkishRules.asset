  m_Script: {fileID: 11500000, guid: 91036662a85844eb162bdfbe2ea8ce9c, type: 3}
  m_Name: TurkishRules
  m_EditorClassIdentifier:
  displayName: Turkish
  description: Dama - pieces move in straight lines on every square, flying kings, mandatory capture.
  longDescription: "- 8x8 board, all squares used, 16 pieces each; the back row starts empty.\n- Orthogonal movement only - no diagonals.\n- Men move forward, left, or right; they capture in all four directions.\n- No 180-degree turn: you can't reverse straight back through the square you just left.\n- Capturing is mandatory - you must play the path that captures the most pieces.\n- Captured pieces are removed immediately - this can open new paths mid-turn.\n- The Dama (king) slides and captures any distance in a straight line.\n- A piece only crowns if it finishes its turn on the back row.\n- White always moves first.\n- Win by capturing every piece, blocking every legal move, or reducing your opponent to one man against your Dama."
  rows: 8
  columns: 8
  pieceRowsPerSide: 2
  movementScheme: 1
  piecesOnAllSquares: 1
  leaveBackRowEmpty: 1
  flyingKings: 1
  menCaptureBackward: 1
  menCannotCaptureKings: 0
  mustCaptureMaximum: 1
  preferKingMover: 0
  preferKingCaptures: 0
  preferEarlierKingCapture: 0
  midChainPromotionRule: 0
  deferCaptureRemoval: 0
  forbidImmediateReversal: 1
  noProgressMoveLimit: 30
  singleManLosesToKing: 1
  firstMoveColor: 1
