  m_Script: {fileID: 11500000, guid: 91036662a85844eb162bdfbe2ea8ce9c, type: 3}
  m_Name: AmericanRules
  m_EditorClassIdentifier:
  displayName: American
  description: Standard 8x8 checkers - men capture only forward, any legal capture is playable.
  longDescription: "- 8x8 board, dark squares only, 12 pieces each.\n- Men move and capture diagonally forward only.\n- Kings move and capture one square, forward or backward - no flying.\n- Capturing is mandatory whenever it's available.\n- If a jump leads to another jump, you must keep jumping.\n- Captured pieces are removed immediately.\n- Reaching the back row crowns a piece and ends its turn right there.\n- Win by capturing every piece or leaving your opponent no legal move."
  rows: 8
  columns: 8
  pieceRowsPerSide: 3
  movementScheme: 0
  piecesOnAllSquares: 0
  leaveBackRowEmpty: 0
  flyingKings: 0
  menCaptureBackward: 0
  menCannotCaptureKings: 0
  mustCaptureMaximum: 0
  preferKingMover: 0
  preferKingCaptures: 0
  preferEarlierKingCapture: 0
  midChainPromotionRule: 1
  deferCaptureRemoval: 0
  forbidImmediateReversal: 0
  noProgressMoveLimit: 40
  singleManLosesToKing: 0
