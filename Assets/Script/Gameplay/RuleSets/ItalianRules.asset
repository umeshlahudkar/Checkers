  m_Script: {fileID: 11500000, guid: 91036662a85844eb162bdfbe2ea8ce9c, type: 3}
  m_Name: ItalianRules
  m_EditorClassIdentifier:
  displayName: Italian
  description: 8x8 draughts - short-range kings only, men can't capture backward or capture Kings.
  longDescription: "- 8x8 board, 12 pieces each; bottom-right corner is a dark square.\n- Men move forward only and can never capture backward.\n- Kings move and capture one square, forward or backward - no flying.\n- Immunity: a man can never capture a King - only a King can.\n- Capturing is mandatory, in order: most pieces taken, then a King's capture beats a man's, then most Kings taken, then whichever captures a King soonest.\n- Captured pieces stay on the board until your turn ends; you can't jump the same piece twice.\n- Reaching the back row crowns a piece and ends its turn right there.\n- White always moves first.\n- Win by capturing every piece or leaving your opponent no legal move."
  rows: 8
  columns: 8
  pieceRowsPerSide: 3
  movementScheme: 0
  piecesOnAllSquares: 0
  leaveBackRowEmpty: 0
  flyingKings: 0
  menCaptureBackward: 0
  menCannotCaptureKings: 1
  mustCaptureMaximum: 1
  preferKingMover: 1
  preferKingCaptures: 1
  preferEarlierKingCapture: 1
  midChainPromotionRule: 1
  deferCaptureRemoval: 1
  forbidImmediateReversal: 0
  noProgressMoveLimit: 40
  singleManLosesToKing: 0
  firstMoveColor: 1
  darkSquareBottomRight: 1
