  m_Script: {fileID: 11500000, guid: 91036662a85844eb162bdfbe2ea8ce9c, type: 3}
  m_Name: BrazilianRules
  m_EditorClassIdentifier:
  displayName: Brazilian
  description: International draughts on a smaller 8x8 board - flying kings, mandatory maximum capture, captures stay on the board until the turn ends.
  longDescription: "<b><color=#D4AF37>Goal:</color></b>\nCapture all of your opponent's pieces, or leave them with no legal move to make.\n\n<b><color=#D4AF37>Board:</color></b>\nInternational draughts' rules on a smaller 8x8 board. Each player starts with 12 pieces filling the first three rows on their side. White always moves first.\n\n<b><color=#D4AF37>Movement:</color></b>\nMen move diagonally forward only. Kings are flying kings - they slide and capture any distance along a diagonal.\n\n<b><color=#D4AF37>Capturing:</color></b>\nCapturing is mandatory, and men may capture in any diagonal direction, including backward. If more than one path is available, you must play the one that captures the most pieces - ties are broken purely by quantity, men or Kings alike.\n\n<b><color=#D4AF37>No-Removal:</color></b>\nA captured piece stays on the board - still blocking its square - until your turn ends; you can't jump the same piece twice.\n\n<b><color=#D4AF37>Kings:</color></b>\nA piece only crowns if it finishes its turn on the back row - jumping through mid-capture and landing elsewhere leaves it a man.\n\n<b><color=#D4AF37>Win:</color></b>\nCapture every enemy piece, or leave your opponent with no legal move."
  rows: 8
  columns: 8
  pieceRowsPerSide: 3
  movementScheme: 0
  piecesOnAllSquares: 0
  leaveBackRowEmpty: 0
  flyingKings: 1
  menCaptureBackward: 1
  menCannotCaptureKings: 0
  mustCaptureMaximum: 1
  preferKingMover: 0
  preferKingCaptures: 0
  preferEarlierKingCapture: 0
  midChainPromotionRule: 0
  deferCaptureRemoval: 1
  forbidImmediateReversal: 0
  noProgressMoveLimit: 25
  singleManLosesToKing: 0
  firstMoveColor: 1
