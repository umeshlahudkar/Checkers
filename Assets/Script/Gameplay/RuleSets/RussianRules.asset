  m_Script: {fileID: 11500000, guid: 91036662a85844eb162bdfbe2ea8ce9c, type: 3}
  m_Name: RussianRules
  m_EditorClassIdentifier:
  displayName: Russian
  description: 8x8 draughts - flying kings, men capture backward, any legal capture is playable.
  longDescription: "- 8x8 board, 12 pieces each.\n- Men move forward only, but capture in any diagonal direction.\n- Capturing is mandatory, but any legal capture path may be chosen.\n- Captured pieces are removed immediately - this can open new paths mid-turn.\n- Kings fly: they slide and capture any distance along a diagonal.\n- A piece crowns immediately mid-capture and must keep capturing with its new king powers.\n- Win by capturing every piece or leaving your opponent no legal move."
  rows: 8
  columns: 8
  pieceRowsPerSide: 3
  movementScheme: 0
  piecesOnAllSquares: 0
  leaveBackRowEmpty: 0
  flyingKings: 1
  menCaptureBackward: 1
  menCannotCaptureKings: 0
  mustCaptureMaximum: 0
  preferKingMover: 0
  preferKingCaptures: 0
  preferEarlierKingCapture: 0
  midChainPromotionRule: 2
  deferCaptureRemoval: 0
  forbidImmediateReversal: 0
  noProgressMoveLimit: 30
  singleManLosesToKing: 0
