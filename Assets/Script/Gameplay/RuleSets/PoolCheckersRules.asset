  m_Script: {fileID: 11500000, guid: 91036662a85844eb162bdfbe2ea8ce9c, type: 3}
  m_Name: PoolCheckersRules
  m_EditorClassIdentifier:
  displayName: Pool Checkers
  description: 8x8 draughts - flying kings, men capture backward, any legal capture is playable.
  longDescription: "- 8x8 board, 12 pieces each; bottom-right corner is a light square.\n- Men move forward only, but capture in any diagonal direction.\n- Capturing is mandatory, but any legal capture path may be chosen.\n- No-Removal: captured pieces stay on the board until your turn ends; you can't jump the same piece twice.\n- Kings fly: they slide and capture any distance along a diagonal.\n- A piece only crowns if it finishes its turn on the back row.\n- Black always moves first.\n- Win by capturing every piece or leaving your opponent no legal move."
  rows: 8
  columns: 8
  pieceRowsPerSide: 3
  movementScheme: 0
  piecesOnAllSquares: 0
  leaveBackRowEmpty: 0
  flyingKings: 1
  menCaptureBackward: 1
  menCannotCaptureKings: 0
  mustCaptureMaximum: 0
  preferKingMover: 0
  preferKingCaptures: 0
  preferEarlierKingCapture: 0
  midChainPromotionRule: 0
  deferCaptureRemoval: 1
  forbidImmediateReversal: 0
  noProgressMoveLimit: 30
  singleManLosesToKing: 0
  firstMoveColor: 2
