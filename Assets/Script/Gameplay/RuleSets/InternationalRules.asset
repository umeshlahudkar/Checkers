  m_Script: {fileID: 11500000, guid: 91036662a85844eb162bdfbe2ea8ce9c, type: 3}
  m_Name: InternationalRules
  m_EditorClassIdentifier:
  displayName: International
  description: 10x10 draughts - flying kings, mandatory maximum capture, men can capture backward.
  longDescription: "- 10x10 board, 20 pieces each.\n- Men move forward only, but capture in any diagonal direction.\n- Capturing is mandatory - you must play the path that captures the most pieces.\n- No-Removal: captured pieces stay on the board until your turn ends; you can't jump the same piece twice.\n- Kings fly: they slide and capture any distance along a diagonal.\n- A piece only crowns if it finishes its turn on the back row.\n- Win by capturing every piece or leaving your opponent no legal move."
  rows: 10
  columns: 10
  pieceRowsPerSide: 4
  movementScheme: 0
  piecesOnAllSquares: 0
  leaveBackRowEmpty: 0
  flyingKings: 1
  menCaptureBackward: 1
  menCannotCaptureKings: 0
  mustCaptureMaximum: 1
  preferKingMover: 0
  preferKingCaptures: 0
  preferEarlierKingCapture: 0
  midChainPromotionRule: 0
  deferCaptureRemoval: 1
  forbidImmediateReversal: 0
  noProgressMoveLimit: 25
  singleManLosesToKing: 0
