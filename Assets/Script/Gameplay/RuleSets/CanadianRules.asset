  m_Script: {fileID: 11500000, guid: 91036662a85844eb162bdfbe2ea8ce9c, type: 3}
  m_Name: CanadianRules
  m_EditorClassIdentifier:
  displayName: Canadian
  description: 12x12 draughts - flying kings, men capture backward, mandatory maximum capture.
  longDescription: "- 12x12 board, 30 pieces each, leaving the middle two rows empty at setup.\n- Men move forward only, but capture in any diagonal direction.\n- Capturing is mandatory - you must play the path that captures the most pieces.\n- No-Removal: captured pieces stay on the board until your turn ends; you can't jump the same piece twice.\n- Kings fly: they slide and capture any distance along a diagonal.\n- A piece only crowns if it finishes its turn on the back row.\n- White always moves first.\n- Win by capturing every piece or leaving your opponent no legal move."
  rows: 12
  columns: 12
  pieceRowsPerSide: 5
  movementScheme: 0
  piecesOnAllSquares: 0
  leaveBackRowEmpty: 0
  flyingKings: 1
  menCaptureBackward: 1
  menCannotCaptureKings: 0
  mustCaptureMaximum: 1
  preferKingMover: 0
  preferKingCaptures: 0
  preferEarlierKingCapture: 0
  midChainPromotionRule: 0
  deferCaptureRemoval: 1
  forbidImmediateReversal: 0
  noProgressMoveLimit: 35
  singleManLosesToKing: 0
  firstMoveColor: 1
