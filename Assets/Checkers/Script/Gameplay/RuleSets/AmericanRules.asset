  m_Script: {fileID: 11500000, guid: 91036662a85844eb162bdfbe2ea8ce9c, type: 3}
  m_Name: AmericanRules
  m_EditorClassIdentifier: 
  displayName: American
  availableInGame: 1
  flag: {fileID: 21300000, guid: fad24b07744d7ad4ebb419d1f0912612, type: 3}
  description: Standard 8x8 checkers, 12 pieces a side - men capture forward only,
    any legal capture is playable, and kings can't fly.
  longDescription: '<b><color=#D4AF37>Goal:</color></b>

    Capture all of your
    opponent''s pieces, or leave them with no legal move to make.


    <b><color=#D4AF37>Board:</color></b>

    Played
    on an 8x8 board, using only the dark squares. Each player starts with 12 pieces
    filling the first three rows on their side.


    <b><color=#D4AF37>Movement:</color></b>

    Men
    move and capture diagonally forward only. Kings move and capture one square at
    a time, forward or backward - they don''t fly.


    <b><color=#D4AF37>Capturing:</color></b>

    Capturing
    is mandatory whenever it''s available, and if a jump leads straight into another
    jump, you must keep jumping. Captured pieces are removed from the board immediately.


    <b><color=#D4AF37>Kings:</color></b>

    Reaching
    the back row crowns a piece immediately and ends its turn right there - even
    mid-capture, even if the new king could otherwise keep going.


    <b><color=#D4AF37>Win:</color></b>

    Capture
    every enemy piece, or leave your opponent with no legal move.


    <b><color=#D4AF37>Draw:</color></b>

    Either
    player may offer a draw at any time; if accepted, the match ends level. The match
    is also drawn if the same position, with the same side to move, repeats three
    times.'
  rows: 8
  columns: 8
  pieceRowsPerSide: 3
  movementScheme: 0
  piecesOnAllSquares: 0
  leaveBackRowEmpty: 0
  flyingKings: 0
  menCaptureBackward: 0
  menCannotCaptureKings: 0
  mustCaptureMaximum: 0
  preferKingMover: 0
  preferKingCaptures: 0
  preferEarlierKingCapture: 0
  midChainPromotionRule: 1
  deferCaptureRemoval: 0
  forbidImmediateReversal: 0
  noProgressMoveLimit: 40
  singleManLosesToKing: 0
  threefoldRepetitionEnabled: 1
  threeVsOneKingDrawLimit: 0
  twoVsOneKingDrawLimit: 0
  oneVsOneIsDraw: 0
  firstMoveColor: 0
  darkSquareBottomRight: 0
