  m_Script: {fileID: 11500000, guid: 91036662a85844eb162bdfbe2ea8ce9c, type: 3}
  m_Name: SpanishRules
  m_EditorClassIdentifier: 
  displayName: Spanish
  availableInGame: 1
  flag: {fileID: 21300000, guid: 9c730e87aa35ac848bbb5a75d40cbc87, type: 3}
  description: 8x8 draughts - flying kings, forward-only men, mandatory maximum capture
    with a tiebreak for the most Kings taken.
  longDescription: '<b><color=#D4AF37>Goal:</color></b>

    Capture all of your
    opponent''s pieces, or leave them with no legal move to make.


    <b><color=#D4AF37>Board:</color></b>

    Played
    on an 8x8 board, with the bottom-right corner square light for each player. Each
    player starts with 12 pieces filling the first three rows on their side. White
    always moves first.


    <b><color=#D4AF37>Movement:</color></b>

    Men move
    diagonally forward only, and can never move or capture backward under any circumstance.
    Kings are flying kings - they slide and capture any distance along a diagonal.


    <b><color=#D4AF37>Capturing:</color></b>

    Capturing
    is mandatory. If more than one path is available, you must play the one that
    captures the most pieces - ties are broken in favor of whichever takes the most
    Kings.


    <b><color=#D4AF37>No-Removal:</color></b>

    A captured piece
    stays on the board - still blocking its square - until your turn ends; you can''t
    jump the same piece twice.


    <b><color=#D4AF37>Kings:</color></b>

    A
    piece only crowns if it finishes its turn on the back row - jumping through mid-capture
    and landing elsewhere leaves it a man.


    <b><color=#D4AF37>Win:</color></b>

    Capture
    every enemy piece, or leave your opponent with no legal move.


    <b><color=#D4AF37>Draw:</color></b>

    Either
    player may offer a draw at any time; if accepted, the match ends level. The match
    is also drawn if the same position, with the same side to move, repeats three
    times.'
  rows: 8
  columns: 8
  pieceRowsPerSide: 3
  movementScheme: 0
  piecesOnAllSquares: 0
  leaveBackRowEmpty: 0
  flyingKings: 1
  menCaptureBackward: 0
  menCannotCaptureKings: 0
  mustCaptureMaximum: 1
  preferKingMover: 0
  preferKingCaptures: 1
  preferEarlierKingCapture: 0
  midChainPromotionRule: 0
  deferCaptureRemoval: 1
  forbidImmediateReversal: 0
  noProgressMoveLimit: 0
  singleManLosesToKing: 0
  threefoldRepetitionEnabled: 1
  threeVsOneKingDrawLimit: 0
  twoVsOneKingDrawLimit: 0
  oneVsOneIsDraw: 0
  firstMoveColor: 1
  darkSquareBottomRight: 0
